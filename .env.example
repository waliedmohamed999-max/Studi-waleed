# الأسهل: حط المفاتيح من جوه الاستوديو (⚙️ الإعدادات)، وهي بتتحفظ هنا في ملف .env لوحدها
# أو انسخ الملف ده باسم .env واكتبها بإيدك (ملف .env مش بيترفع على Git)

# Claude: السيناريو والذكاء الاصطناعي في كل الاستوديو
# من https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# fal.ai: الصور الواقعية، والفيديو المتولد، وحركة الشفايف
# من https://fal.ai/dashboard/keys (بتدفع على قد الاستخدام، اشحن رصيد الأول)
FAL_KEY=

# ElevenLabs: تعليق صوتي احترافي ومزيكا ومؤثرات (فيه أصوات سعودية في مكتبة الأصوات)
# من https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Pexels: لقطات B-roll حقيقية مجانية للمونتاج الأوتوماتيك
# من https://www.pexels.com/api/ (مجاني)
PEXELS_API_KEY=

# للتجربة من غير مفاتيح: كل الذكاء الاصطناعي بيرجع نتايج تجريبية مجانية
# AI_MOCK=1
