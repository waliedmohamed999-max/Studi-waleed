# انسخ الملف ده باسم .env وحط مفاتيحك (ملف .env مش بيترفع على Git)

# Claude: السيناريو والذكاء الاصطناعي في كل الاستوديو
# من https://platform.claude.com
ANTHROPIC_API_KEY=

# fal.ai: توليد الصور الواقعية والفيديو (مخرج الأفلام)
# من https://fal.ai/dashboard/keys (بتدفع على قد الاستخدام، اشحن رصيد الأول)
FAL_KEY=

# ElevenLabs: تعليق صوتي احترافي (فيه أصوات سعودية في مكتبة الأصوات)
# من https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# للتجربة من غير مفاتيح: كل الذكاء الاصطناعي بيرجع نتايج تجريبية مجانية
# AI_MOCK=1
